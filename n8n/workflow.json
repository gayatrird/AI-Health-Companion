                      "typeVersion":  2,
                      "position":  [
                                       940,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "return [{json:{risk_level:\u0027EMERGENCY / SEEK IMMEDIATE CARE\u0027, guidance:\u0027Seek immediate professional or emergency medical care. Do not rely on this workflow for emergency assessment.\u0027, event_logged:true}}];"
                                     },
                      "name":  "Emergency Response",
