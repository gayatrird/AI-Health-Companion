rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid} {
      allow create: if isOwner(uid);
      allow read, update, delete: if isOwner(uid);
      match /habits/{habitId} { allow read, write: if isOwner(uid); }
      match /symptom_checks/{checkId} { allow read, write: if isOwner(uid); }
      match /feedback/{feedbackId} { allow read, write: if isOwner(uid); }
    }
  }
}
