                  {
                      "parameters":  {
                                         "jsCode":  "const body = $json.body || {};\nif (!body.message \u0026\u0026 !body.symptoms) throw new Error(\u0027Message or symptoms is required\u0027);\nreturn [{ json: { ...body, validated: true } }];"
                                     },
                      "name":  "Validate Input",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       500,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const rawMessage = String($json.message ?? $json.body?.message ?? \u0027\u0027);\nconst rawSymptoms = String($json.symptoms ?? $json.body?.symptoms ?? \u0027\u0027);\nconst normalizedText = `${rawMessage} ${rawSymptoms}`\n  .trim()\n  .toLowerCase()\n  .replace(/\\s+/g, \u0027 \u0027);\n\nconst emergencyPhrases = [\n  \u0027severe chest pain\u0027,\n  \u0027severe difficulty breathing\u0027,\n  \u0027unconscious\u0027,\n  \u0027severe bleeding\u0027\n];\n\nconst emergency = emergencyPhrases.some(phrase =\u003e normalizedText.includes(phrase));\nreturn [{ json: { ...$json, normalized_text: normalizedText, emergency } }];"
                                     },
                      "name":  "Safety Check",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       720,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "conditions":  {
                                                            "boolean":  [
                                                                            {
                                                                                "value1":  "={{ $json.emergency === true }}",
                                                                                "operation":  "isTrue"
                                                                            }
                                                                        ]
                                                        }
                                     },
                      "name":  "Emergency?",
