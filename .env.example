# The project works without this file in DEMO MODE.
AI_MODE=mock

# Optional local n8n production webhook. The app falls back to mock mode when
# this workflow is unavailable or inactive.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/ai-health-companion

# Add values only when connecting IBM watsonx in a future deployment.
IBM_API_KEY=
IBM_PROJECT_ID=
IBM_URL=

# Firebase Admin SDK is optional and not used by the browser Firebase SDK.
# Never commit a service-account JSON file.
FIREBASE_ADMIN_CREDENTIALS_PATH=
