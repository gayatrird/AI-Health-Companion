        ],
        "id": "6d62d25d-904e-42fa-994f-fdf1ed0c8374"
      },
      {
        "parameters": {
          "jsCode": "const raw = $json.message ?? $json.body?.message ?? $json.symptoms ?? \"\";\n\nconst text = String(raw)\n  .trim()\n  .toLowerCase()\n  .replace(/\\s+/g, \" \");\n\nconst flags = [\n  \"severe chest pain\",\n  \"severe difficulty breathing\",\n  \"unconscious\",\n  \"severe bleeding\"\n];\n\nconst matched = flags.filter(flag => text.includes(flag));\n\nreturn [{\n  json: {\n    ...$json,\n    emergency: matched.length > 0,\n    matched_flags: matched\n  }\n}];"
        },
        "name": "Safety Check",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
